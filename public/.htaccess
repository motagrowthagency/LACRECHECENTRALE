<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  Options -Indexes

  # If the requested file physically exists (assets, images, etc.), serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Fallback everything else to index.html for the React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Security: prevent direct access to sensitive files
<FilesMatch "^\.(env|git|htaccess)">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
