# Admin dashboard password (required — the admin panel refuses all logins without this)
ADMIN_PASSWORD=

# MySQL (optional — if left blank, leads are stored in /data/leads.json instead)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lacentrale_creche
DB_USER=lacentrale_admin
DB_PASSWORD=

# Auto-generated on first run if left blank — set explicitly to keep admin
# sessions valid across deployments.
ADMIN_SESSION_SECRET=

NOTIFICATION_EMAIL=contact@lacentralecreche.com
